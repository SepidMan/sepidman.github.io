---
layout: layouts/base.njk
---
<article class="project-page">
  <section class="page-hero page-hero-project">
    <div class="page-hero-copy">
      <p class="eyebrow">{{ site.pages.projects.hero.eyebrow }}</p>
      <h1>{{ title }}</h1>
      <p class="page-lead">{{ summary }}</p>
    </div>
    <div class="page-hero-visual visual-swatch visual-swatch-{{ coverTone or 'sage' }}">
      <span>{{ role }}</span>
      <strong>{{ timeline }}</strong>
    </div>
  </section>

  <section class="project-meta-grid">
    {% include "partials/project-meta.njk" %}
  </section>

  <section class="project-rich-text">
    {{ content | safe }}
  </section>

  <section class="cta-panel">
    <p class="eyebrow">{{ site.pages.projects.callToAction.eyebrow }}</p>
    <h2>{{ site.pages.projects.callToAction.headline }}</h2>
    <div class="cta-row">
      <a class="button" href="{{ site.pages.projects.callToAction.primary.url }}">{{ site.pages.projects.callToAction.primary.label }}</a>
      <a class="button button-secondary" href="{{ site.pages.projects.callToAction.secondary.url }}">{{ site.pages.projects.callToAction.secondary.label }}</a>
    </div>
  </section>
</article>

<section class="resume-hero">
  <div>
    <p class="eyebrow">{{ site.pages.resume.heroEyebrow }}</p>
    <h1>{{ resume.basics.name }}</h1>
    <p class="resume-title">{{ resume.basics.label }}</p>
    <p class="page-lead">{{ resume.basics.summary }}</p>
  </div>
  <aside class="resume-contact-card">
    <p><strong>{{ site.pages.resume.contactLabels.location }}</strong><span>{{ site.author.location }}</span></p>
    <p><strong>{{ site.pages.resume.contactLabels.email }}</strong><a href="mailto:{{ resume.basics.email }}">{{ resume.basics.email }}</a></p>
    {% set linkedin = resume.basics.profiles | primaryProfile("LinkedIn") %}
    {% set github = resume.basics.profiles | primaryProfile("GitHub") %}
    {% if linkedin %}
      <p><strong>{{ site.pages.resume.contactLabels.linkedin }}</strong><a href="{{ linkedin.url }}">{{ linkedin.url | replace("https://www.", "") | replace("https://", "") }}</a></p>
    {% endif %}
    {% if github %}
      <p><strong>{{ site.pages.resume.contactLabels.github }}</strong><a href="{{ github.url }}">{{ github.url | replace("https://www.", "") | replace("https://", "") }}</a></p>
    {% endif %}
    <div class="download-menu" data-download-menu>
      <button
        class="button download-menu-summary"
        type="button"
        aria-expanded="false"
        aria-controls="resume-download-menu"
        data-download-menu-toggle
      >
        <span class="download-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M12 4v10"></path>
            <path d="M8 10.5 12 14.5 16 10.5"></path>
            <path d="M5 18h14"></path>
          </svg>
        </span>
        <span>{{ site.pages.resume.downloadButtonLabel }}</span>
      </button>
      <div
        class="download-menu-items"
        id="resume-download-menu"
        hidden
        data-download-menu-items
      >
        {% for item in resume.downloadOptions %}
          <a class="download-menu-link" href="{{ item.href }}" download>{{ item.label }}</a>
        {% endfor %}
      </div>
    </div>
  </aside>
</section>

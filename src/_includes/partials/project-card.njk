<article class="project-card">
  <a class="project-card-link" href="{{ project.url }}">
    <div class="project-card-visual visual-swatch visual-swatch-{{ project.data.projectView.presentation.coverTone }}">
      <span>{{ project.data.projectView.role }}</span>
      <strong>{{ project.data.projectView.timeline }}</strong>
    </div>
    <div class="project-card-copy">
      <p class="eyebrow">{{ project.data.projectView.presentation.label or site.pages.projects.card.eyebrow }}</p>
      <h3>{{ project.data.projectView.title }}</h3>
      <p>{{ project.data.projectView.summary }}</p>
      <ul class="tag-list">
        {% for tool in project.data.projectView.tools %}
          <li>{{ tool }}</li>
        {% endfor %}
      </ul>
    </div>
  </a>
</article>

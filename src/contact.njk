---
layout: layouts/base.njk
eleventyComputed:
  title: "{{ site.pages.contact.seo.title }}"
  description: "{{ site.pages.contact.seo.description }}"
---
<section class="contact-layout">
  <div class="contact-intro">
    <p class="eyebrow">{{ site.pages.contact.eyebrow }}</p>
    <h1>{{ site.pages.contact.headline }}</h1>
    <p class="page-lead">{{ site.pages.contact.intro }}</p>
    <p>{{ site.pages.contact.availability }}</p>
  </div>

  <div class="contact-grid">
    {% for item in site.social %}
      <a class="contact-card contact-card-link" href="{{ item.url }}" target="_blank" rel="noreferrer" {% if item.iconToken %}data-brand="{{ item.iconToken }}"{% endif %}>
        <div class="contact-card-icon" aria-hidden="true">
          {% set iconKind = item.iconKind %}
          {% set iconName = item.iconName %}
          {% set iconStyle = item.iconStyle %}
          {% include "partials/contact-icon.njk" %}
        </div>
        <p class="eyebrow">{{ item.name }}</p>
        <h2>{{ item.url | replace("https://www.", "") | replace("https://", "") }}</h2>
        <p>{{ site.pages.contact.socialLinkDescription }}</p>
      </a>
    {% endfor %}

    <a class="contact-card contact-card-link" href="mailto:{{ site.author.email }}" data-brand="email">
      <div class="contact-card-icon" aria-hidden="true">
        {% set iconKind = "custom" %}
        {% set iconName = "email" %}
        {% set iconStyle = null %}
        {% include "partials/contact-icon.njk" %}
      </div>
      <p class="eyebrow">{{ site.pages.contact.emailLinkLabel }}</p>
      <h2>{{ site.author.email }}</h2>
      <p>{{ site.pages.contact.emailLinkDescription }}</p>
    </a>
  </div>
</section>

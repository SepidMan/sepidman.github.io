---
layout: layouts/base.njk
eleventyComputed:
  title: "{{ site.pages.about.seo.title }}"
  description: "{{ site.pages.about.seo.description }}"
---
<section class="page-intro">
  <p class="eyebrow">{{ site.pages.about.eyebrow }}</p>
  <h1>{{ site.pages.about.headline }}</h1>
  {% for paragraph in site.about.summary %}
    <p class="page-lead">{{ paragraph }}</p>
  {% endfor %}
</section>

<section class="split-section">
  <article class="content-card">
    <p class="eyebrow">{{ site.pages.about.guidance.eyebrow }}</p>
    <h2>{{ site.pages.about.guidance.headline }}</h2>
    <p>{{ site.pages.about.guidance.body }}</p>
  </article>
  <aside class="note-card">
    <p class="eyebrow">{{ site.pages.about.guidance.principlesEyebrow }}</p>
    <ul class="plain-list">
      {% for principle in site.about.principles %}
        <li>{{ principle }}</li>
      {% endfor %}
    </ul>
  </aside>
</section>

<section class="section-block">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{{ site.pages.about.workingStyle.eyebrow }}</p>
      <h2>{{ site.pages.about.workingStyle.headline }}</h2>
    </div>
  </div>
  <div class="cards-grid">
    {% for card in site.pages.about.workingStyle.cards %}
      <article class="info-card">
        <p class="eyebrow">{{ card.eyebrow }}</p>
        <h3>{{ card.headline }}</h3>
        <p>{{ card.body }}</p>
      </article>
    {% endfor %}
  </div>
</section>

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "./schema.json",
  "title": "Canonical Profile Schema",
  "description": "Internal source-of-truth schema for resume, RenderCV export metadata, and website content.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional schema URL for the canonical profile file."
    },
    "meta": {
      "$ref": "./jsonresume.schema.json#/properties/meta"
    },
    "basics": {
      "allOf": [
        {
          "$ref": "./jsonresume.schema.json#/properties/basics"
        },
        {
          "type": "object",
          "properties": {
            "shortName": {
              "type": "string",
              "description": "Short display name for the website and other UI surfaces."
            },
            "connections": {
              "type": "array",
              "description": "Additional arbitrary header/contact connections that do not map cleanly to JSON Resume profiles.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "icon": {
                    "$ref": "#/definitions/iconDefinition"
                  }
                },
                "required": [
                  "label",
                  "icon"
                ]
              }
            },
            "photo": {
              "type": "string",
              "description": "Optional explicit RenderCV photo path or URL when it should differ from basics.image."
            }
          }
        }
      ]
    },
    "work": {
      "$ref": "./jsonresume.schema.json#/properties/work"
    },
    "volunteer": {
      "$ref": "./jsonresume.schema.json#/properties/volunteer"
    },
    "education": {
      "$ref": "./jsonresume.schema.json#/properties/education"
    },
    "awards": {
      "$ref": "./jsonresume.schema.json#/properties/awards"
    },
    "certificates": {
      "$ref": "./jsonresume.schema.json#/properties/certificates"
    },
    "publications": {
      "type": "array",
      "description": "JSON Resume publications plus RenderCV-specific publication fields.",
      "items": {
        "allOf": [
          {
            "$ref": "./jsonresume.schema.json#/properties/publications/items"
          },
          {
            "type": "object",
            "properties": {
              "authors": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "RenderCV publication authors list."
              },
              "doi": {
                "type": "string",
                "description": "DOI identifier for RenderCV publication entries."
              },
              "journal": {
                "type": "string",
                "description": "Journal, conference, or venue name for RenderCV publication entries."
              }
            }
          }
        ]
      }
    },
    "skills": {
      "$ref": "./jsonresume.schema.json#/properties/skills"
    },
    "languages": {
      "$ref": "./jsonresume.schema.json#/properties/languages"
    },
    "interests": {
      "$ref": "./jsonresume.schema.json#/properties/interests"
    },
    "references": {
      "$ref": "./jsonresume.schema.json#/properties/references"
    },
    "projects": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "./jsonresume.schema.json#/properties/projects/items"
          },
          {
            "type": "object",
            "properties": {
              "presentation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "listing": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "featured": {
                        "type": "boolean"
                      },
                      "order": {
                        "type": "integer"
                      },
                      "label": {
                        "type": "string"
                      }
                    }
                  },
                  "cover": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "tone": {
                        "type": "string"
                      }
                    }
                  },
                  "meta": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "focus": {
                        "type": "string"
                      }
                    }
                  },
                  "seo": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                },
                "required": [
                  "slug"
                ]
              }
            }
          }
        ]
      }
    },
    "website": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string"
        },
        "navigation": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/websiteNavigationItem"
          }
        },
        "pages": {
          "$ref": "#/definitions/websitePages"
        }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rendercv": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "locale": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "language": {
                  "type": "string"
                }
              }
            },
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "currentDate": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": [
                        "today"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  ]
                },
                "boldKeywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "pdfTitle": {
                  "type": "string"
                }
              }
            },
            "variants": {
              "type": "object",
              "description": "Named PDF variants and their pipeline metadata.",
              "additionalProperties": {
                "$ref": "#/definitions/rendercvVariant"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "websiteNavigationItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/definitions/iconDefinition"
        }
      },
      "required": [
        "label",
        "url"
      ]
    },
    "iconDefinition": {
      "description": "Icon descriptor supporting either legacy custom icon tokens or Font Awesome icon identifiers.",
      "oneOf": [
        {
          "type": "string",
          "description": "Legacy migration form. Interpreted as a custom icon token."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "custom"
            },
            "name": {
              "type": "string",
              "description": "Custom icon token used by the website's own SVG icon library."
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fontawesome"
            },
            "name": {
              "type": "string",
              "description": "Font Awesome icon name without the fa- prefix."
            },
            "style": {
              "type": "string",
              "enum": [
                "solid",
                "regular",
                "brands"
              ],
              "description": "Font Awesome style family."
            }
          },
          "required": [
            "kind",
            "name",
            "style"
          ]
        }
      ]
    },
    "websiteAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "asset": {
          "type": "string",
          "enum": [
            "cvPdf",
            "resumePdf",
            "jsonResume"
          ],
          "description": "Generated asset identifier to avoid duplicating final asset URLs in source data."
        }
      },
      "required": [
        "label"
      ],
      "oneOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "asset"
          ]
        }
      ]
    },
    "websiteStat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ]
    },
    "websiteHeroBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "primaryAction": {
          "$ref": "#/definitions/websiteAction"
        },
        "secondaryAction": {
          "$ref": "#/definitions/websiteAction"
        }
      }
    },
    "websitePages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "$ref": "#/definitions/websitePageHome"
        },
        "about": {
          "$ref": "#/definitions/websitePageAbout"
        },
        "contact": {
          "$ref": "#/definitions/websitePageContact"
        },
        "work": {
          "$ref": "#/definitions/websitePageSimpleHero"
        },
        "resume": {
          "$ref": "#/definitions/websitePageResume"
        },
        "projects": {
          "$ref": "#/definitions/websitePageProjects"
        },
        "footer": {
          "$ref": "#/definitions/websiteFooter"
        }
      }
    },
    "websitePageSeo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "websitePageSimpleHero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seo": {
          "$ref": "#/definitions/websitePageSeo"
        },
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        }
      }
    },
    "websitePageAbout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seo": {
          "$ref": "#/definitions/websitePageSeo"
        },
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "introCard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "principlesEyebrow": {
              "type": "string"
            }
          }
        },
        "featureCards": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "cards": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "eyebrow": {
                    "type": "string"
                  },
                  "headline": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "websitePageHome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seo": {
          "$ref": "#/definitions/websitePageSeo"
        },
        "hero": {
          "$ref": "#/definitions/websiteHeroBlock"
        },
        "stats": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/websiteStat"
          }
        },
        "graphicLabels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": "string"
            },
            "bottom": {
              "type": "string"
            }
          }
        },
        "aside": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "featuredCollection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "linkLabel": {
              "type": "string"
            }
          }
        },
        "narrative": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "body": {
              "type": "string"
            }
          }
        },
        "focusList": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "primary": {
              "$ref": "#/definitions/websiteAction"
            },
            "secondary": {
              "$ref": "#/definitions/websiteAction"
            }
          }
        }
      }
    },
    "websitePageContact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seo": {
          "$ref": "#/definitions/websitePageSeo"
        },
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "socialLinkDescription": {
          "type": "string"
        },
        "emailLinkLabel": {
          "type": "string"
        },
        "emailLinkDescription": {
          "type": "string"
        }
      }
    },
    "websitePageResume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seo": {
          "$ref": "#/definitions/websitePageSeo"
        },
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            }
          }
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "location": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "linkedin": {
                  "type": "string"
                },
                "github": {
                  "type": "string"
                }
              }
            },
            "downloadLabel": {
              "type": "string"
            },
            "downloads": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "resumePdf": {
                  "type": "string"
                },
                "cvPdf": {
                  "type": "string"
                },
                "jsonResume": {
                  "type": "string"
                }
              }
            }
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "experience": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "eyebrow": {
                  "type": "string"
                },
                "headline": {
                  "type": "string"
                },
                "presentLabel": {
                  "type": "string"
                }
              }
            },
            "education": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "eyebrow": {
                  "type": "string"
                }
              }
            },
            "skills": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "eyebrow": {
                  "type": "string"
                }
              }
            },
            "supporting": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "eyebrow": {
                  "type": "string"
                },
                "certificatesHeading": {
                  "type": "string"
                },
                "languagesHeading": {
                  "type": "string"
                },
                "projectsHeading": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "websitePageProjects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            }
          }
        },
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            }
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roleLabel": {
              "type": "string"
            },
            "timelineLabel": {
              "type": "string"
            },
            "toolsLabel": {
              "type": "string"
            },
            "focusLabel": {
              "type": "string"
            }
          }
        },
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "primary": {
              "$ref": "#/definitions/websiteAction"
            },
            "secondary": {
              "$ref": "#/definitions/websiteAction"
            }
          }
        }
      }
    },
    "websiteFooter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contactEyebrow": {
          "type": "string"
        },
        "downloadLabel": {
          "type": "string"
        }
      }
    },
    "rendercvVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "profile",
        "theme",
        "output"
      ]
    }
  }
}

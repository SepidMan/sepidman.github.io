{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string"
    },
    "navigation": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/websiteNavigationItem"
      }
    },
    "pages": {
      "$ref": "#/definitions/websitePages"
    }
  },
  "definitions": {
    "websiteNavigationItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "icon": {
          "$ref": "./common.schema.json#/definitions/iconDefinition"
        }
      },
      "required": ["label", "url"]
    },
    "websiteStat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": ["label", "value"]
    },
    "websiteHeroBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "primaryAction": {
          "$ref": "./common.schema.json#/definitions/websiteAction"
        },
        "secondaryAction": {
          "$ref": "./common.schema.json#/definitions/websiteAction"
        }
      }
    },
    "websitePages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "$ref": "#/definitions/websitePageHome"
        },
        "about": {
          "$ref": "#/definitions/websitePageAbout"
        },
        "contact": {
          "$ref": "#/definitions/websitePageContact"
        },
        "work": {
          "$ref": "#/definitions/websitePageSimpleHero"
        },
        "resume": {
          "$ref": "#/definitions/websitePageResume"
        },
        "projects": {
          "$ref": "#/definitions/websitePageProjects"
        },
        "footer": {
          "$ref": "#/definitions/websiteFooter"
        }
      }
    },
    "websitePageSeo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "websitePageSimpleHero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seo": {
          "$ref": "#/definitions/websitePageSeo"
        },
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        }
      }
    },
    "websitePageAbout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seo": {
          "$ref": "#/definitions/websitePageSeo"
        },
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "introCard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "principlesEyebrow": {
              "type": "string"
            }
          }
        },
        "featureCards": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "cards": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "eyebrow": {
                    "type": "string"
                  },
                  "headline": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "websitePageHome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seo": {
          "$ref": "#/definitions/websitePageSeo"
        },
        "hero": {
          "$ref": "#/definitions/websiteHeroBlock"
        },
        "stats": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/websiteStat"
          }
        },
        "graphicLabels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": "string"
            },
            "bottom": {
              "type": "string"
            }
          }
        },
        "aside": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "featuredCollection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "linkLabel": {
              "type": "string"
            }
          }
        },
        "narrative": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "body": {
              "type": "string"
            }
          }
        },
        "focusList": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "primary": {
              "$ref": "./common.schema.json#/definitions/websiteAction"
            },
            "secondary": {
              "$ref": "./common.schema.json#/definitions/websiteAction"
            }
          }
        }
      }
    },
    "websitePageContact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seo": {
          "$ref": "#/definitions/websitePageSeo"
        },
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        },
        "socialLinkDescription": {
          "type": "string"
        },
        "emailLinkLabel": {
          "type": "string"
        },
        "emailLinkDescription": {
          "type": "string"
        }
      }
    },
    "websitePageResume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seo": {
          "$ref": "#/definitions/websitePageSeo"
        },
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            }
          }
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "location": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "linkedin": {
                  "type": "string"
                },
                "github": {
                  "type": "string"
                }
              }
            },
            "downloadLabel": {
              "type": "string"
            },
            "downloads": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "resumePdf": {
                  "type": "string"
                },
                "cvPdf": {
                  "type": "string"
                },
                "jsonResume": {
                  "type": "string"
                }
              }
            }
          }
        },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "experience": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "eyebrow": {
                  "type": "string"
                },
                "headline": {
                  "type": "string"
                },
                "presentLabel": {
                  "type": "string"
                }
              }
            },
            "education": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "eyebrow": {
                  "type": "string"
                }
              }
            },
            "skills": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "eyebrow": {
                  "type": "string"
                }
              }
            },
            "supporting": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "eyebrow": {
                  "type": "string"
                },
                "certificatesHeading": {
                  "type": "string"
                },
                "languagesHeading": {
                  "type": "string"
                },
                "projectsHeading": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "websitePageProjects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            }
          }
        },
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            }
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roleLabel": {
              "type": "string"
            },
            "timelineLabel": {
              "type": "string"
            },
            "toolsLabel": {
              "type": "string"
            },
            "focusLabel": {
              "type": "string"
            }
          }
        },
        "callToAction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string"
            },
            "headline": {
              "type": "string"
            },
            "primary": {
              "$ref": "./common.schema.json#/definitions/websiteAction"
            },
            "secondary": {
              "$ref": "./common.schema.json#/definitions/websiteAction"
            }
          }
        }
      }
    },
    "websiteFooter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contactEyebrow": {
          "type": "string"
        },
        "downloadLabel": {
          "type": "string"
        }
      }
    }
  }
}

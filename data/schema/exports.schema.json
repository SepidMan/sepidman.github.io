{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rendercv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": "string"
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currentDate": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": ["today"]
                },
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              ]
            },
            "boldKeywords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pdfTitle": {
              "type": "string"
            }
          }
        },
        "variants": {
          "type": "object",
          "description": "Named PDF variants and their pipeline metadata.",
          "additionalProperties": {
            "$ref": "#/definitions/rendercvVariant"
          }
        }
      }
    }
  },
  "definitions": {
    "rendercvVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": ["profile", "theme", "output"]
    }
  }
}

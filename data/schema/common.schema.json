{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "iconDefinition": {
      "description": "Icon descriptor supporting either legacy custom icon tokens or Font Awesome icon identifiers.",
      "oneOf": [
        {
          "type": "string",
          "description": "Legacy migration form. Interpreted as a custom icon token."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "custom"
            },
            "name": {
              "type": "string",
              "description": "Custom icon token used by the website's own SVG icon library."
            }
          },
          "required": ["kind", "name"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fontawesome"
            },
            "name": {
              "type": "string",
              "description": "Font Awesome icon name without the fa- prefix."
            },
            "style": {
              "type": "string",
              "enum": ["solid", "regular", "brands"],
              "description": "Font Awesome style family."
            }
          },
          "required": ["kind", "name", "style"]
        }
      ]
    },
    "websiteAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "asset": {
          "type": "string",
          "enum": ["cvPdf", "resumePdf", "jsonResume"],
          "description": "Generated asset identifier to avoid duplicating final asset URLs in source data."
        }
      },
      "required": ["label"],
      "oneOf": [
        {
          "required": ["url"]
        },
        {
          "required": ["asset"]
        }
      ]
    }
  }
}

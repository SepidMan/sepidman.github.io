{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "basicsExtension": {
      "type": "object",
      "properties": {
        "shortName": {
          "type": "string",
          "description": "Short display name for the website and other UI surfaces."
        },
        "connections": {
          "type": "array",
          "description": "Additional arbitrary header/contact connections that do not map cleanly to JSON Resume profiles.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "icon": {
                "$ref": "./common.schema.json#/definitions/iconDefinition"
              }
            },
            "required": ["label", "icon"]
          }
        },
        "photo": {
          "type": "string",
          "description": "Optional explicit RenderCV photo path or URL when it should differ from basics.image."
        }
      }
    },
    "publicationExtension": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "RenderCV publication authors list."
        },
        "doi": {
          "type": "string",
          "description": "DOI identifier for RenderCV publication entries."
        },
        "journal": {
          "type": "string",
          "description": "Journal, conference, or venue name for RenderCV publication entries."
        }
      }
    },
    "projectExtension": {
      "type": "object",
      "properties": {
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slug": {
              "type": "string"
            },
            "listing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "featured": {
                  "type": "boolean"
                },
                "order": {
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                }
              }
            },
            "cover": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tone": {
                  "type": "string"
                }
              }
            },
            "meta": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "focus": {
                  "type": "string"
                }
              }
            },
            "seo": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "required": ["slug"]
        }
      }
    }
  }
}

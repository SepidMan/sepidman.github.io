{
  "name": "Eleventy Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "init": true,
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ecmel.vscode-html-css",
        "DavidAnson.vscode-markdownlint",
        "EditorConfig.EditorConfig",
        "sissel.shopify-liquid",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Eleventy live preview",
      "onAutoForward": "openPreview",
      "requireLocalPort": true
    }
  },
  "postCreateCommand": "bash -lc 'npm install && ~/.pixi/bin/pixi install --all'",
  "postAttachCommand": "bash -lc 'echo \"Run npx task dev for the site, npx task build:resume for the default PDF, or npx task build for the full pipeline.\"'",
  "remoteUser": "node"
}
